# ============================================================
# mccms 部署环境变量模板
# 用法：复制本文件为 .env 后填写，docker compose 会自动读取。
#   cp .env.example .env
# ============================================================

# 爱发电 OpenAPI 凭据（用于「主动对账」拉取订单）。
# 不填则关闭主动查询，仅靠爱发电 webhook 推送收单。
MCCMS_AFDIAN_USER_ID=
MCCMS_AFDIAN_TOKEN=

# 每个「月」折算多少天。默认 31，不填用默认。
MCCMS_AFDIAN_DAYS_PER_MONTH=31